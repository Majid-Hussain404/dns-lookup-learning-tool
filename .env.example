# DNS Lookup Learning Tool - Environment Configuration Example

# Backend Server Port (defaults to 5001 if not specified)
PORT=5001

# Allowed CORS origins for the backend (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# DNS Query Timeout in Milliseconds
DNS_TIMEOUT_MS=5000

# Frontend API URL (for production client build)
VITE_API_BASE_URL=http://localhost:5000/api
