{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ],
  "services": {
    "server": {
      "framework": "express",
      "rootDirectory": "server"
    },
    "client": {
      "framework": "vite",
      "rootDirectory": "client"
    }
  }
}
